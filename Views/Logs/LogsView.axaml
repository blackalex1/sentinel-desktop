<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SentinelDesktop.ViewModels"
             xmlns:models="using:SentinelDesktop.Models"
             x:Class="SentinelDesktop.Views.Logs.LogsView"
             x:DataType="vm:LogsViewModel"
             x:Name="Root">

    <Grid RowDefinitions="Auto,Auto,*" Margin="32,24,32,28">
        
        <!-- 1. TOOLBAR HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
            <!-- Left Info -->
            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Журнал и телеметрия ядра" FontSize="22" FontWeight="ExtraBold" Foreground="White" />
                    <Border Background="#1E1B4B" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayCount, StringFormat='Записей: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#D8B4FE" FontFamily="Consolas, monospace" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Прямой перехват stdout/stderr потоков ядра Sing-box и событий FFI" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Right Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Copy Logs -->
                <Button Command="{Binding CopyLogsCommand}"
                        Padding="11,7" CornerRadius="8" Background="#141A30" BorderBrush="#253050" BorderThickness="1" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Width="11" Height="11" Foreground="#CBD5E1" />
                        <TextBlock Text="Копировать" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" />
                    </StackPanel>
                </Button>

                <!-- Clear Logs -->
                <Button Command="{Binding ClearLogsCommand}"
                        Padding="11,7" CornerRadius="8" Background="#2D1215" BorderBrush="#7F1D1D" BorderThickness="1" Cursor="Hand" ToolTip.Tip="Очистить буфер">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="11" Height="11" Foreground="#F87171" />
                        <TextBlock Text="Очистить" FontSize="11" FontWeight="SemiBold" Foreground="#F87171" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. FILTER & SEARCH CONTROLS -->
        <Border Grid.Row="1" Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Filter Segment Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="ALL"
                            Classes="segment-btn"
                            Classes.active="{Binding SelectedFilter, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                            Padding="12,6">
                        <TextBlock Text="Все логи" FontSize="11" />
                    </Button>
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="CORE"
                            Classes="segment-btn"
                            Padding="12,6">
                        <TextBlock Text="Ядро прокси (Core)" FontSize="11" />
                    </Button>
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="APP"
                            Classes="segment-btn"
                            Padding="12,6">
                        <TextBlock Text="Приложение (Sentinel)" FontSize="11" />
                    </Button>
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="ERROR"
                            Classes="segment-btn"
                            Padding="12,6">
                        <TextBlock Text="Ошибки / Warn" FontSize="11" />
                    </Button>
                </StackPanel>

                <!-- Right Group: Log Level Selector & Search Box -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Log Level Selector -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Детализация:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding AvailableLogLevels}"
                                  SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}"
                                  Width="180"
                                  Height="32"
                                  CornerRadius="8"
                                  Background="#080C1A"
                                  BorderBrush="#1E293B"
                                  FontSize="11">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:LogLevelOption">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Search Input Box -->
                    <TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
                             Width="190"
                             Padding="10,6"
                             CornerRadius="8"
                             Background="#080C1A"
                             BorderBrush="#1E293B"
                             Watermark="Поиск по тексту..."
                             FontSize="11"
                             FontFamily="Consolas, monospace" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. CYBER CONSOLE TERMINAL (VIRTUALIZED HIGH-PERFORMANCE LISTBOX) -->
        <Border Grid.Row="2"
                Background="#060914"
                BorderBrush="#1E2638"
                BorderThickness="1"
                CornerRadius="14"
                Padding="8,8">
            <ListBox ItemsSource="{Binding DisplayLogs}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     x:CompileBindings="False">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="6,2" />
                        <Setter Property="MinHeight" Value="20" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="#1E2638" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#0F172A" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,1">
                            <!-- Timestamp -->
                            <TextBlock Text="{Binding TimeFormatted}"
                                       FontFamily="Consolas, monospace"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       Margin="0,0,10,0"
                                       DockPanel.Dock="Left" />

                            <!-- Source Tag -->
                            <Border Background="{Binding SourceBg}"
                                    CornerRadius="4"
                                    Padding="5,1"
                                    Margin="0,0,8,0"
                                    DockPanel.Dock="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{Binding SourceColor}"
                                           FontFamily="Consolas, monospace" />
                            </Border>

                            <!-- Level Tag -->
                            <TextBlock Text="{Binding Level, StringFormat='[{0}]'}"
                                       FontFamily="Consolas, monospace"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{Binding LevelColor}"
                                       Margin="0,0,10,0"
                                       DockPanel.Dock="Left" />

                            <!-- Log Message Content -->
                            <TextBlock Text="{Binding Message}"
                                       FontFamily="Consolas, monospace"
                                       FontSize="11"
                                       Foreground="{Binding LevelColor}"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
