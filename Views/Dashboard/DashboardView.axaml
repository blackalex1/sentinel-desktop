<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SentinelDesktop.ViewModels"
             xmlns:controls="using:SentinelDesktop.Controls"
             x:Class="SentinelDesktop.Views.Dashboard.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="22" Margin="32,16,32,28" MaxWidth="880" HorizontalAlignment="Stretch">

            <!-- 0. MISSING CORE WARNING & ONE-CLICK DOWNLOAD BANNER -->
            <Border IsVisible="{Binding IsCoreMissing}"
                    Background="#2A1608" BorderBrush="#F59E0B" BorderThickness="1.5"
                    CornerRadius="14" Padding="18,14">
                <DockPanel>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#451A03" BorderBrush="#F59E0B" BorderThickness="1" Margin="0,0,14,0" DockPanel.Dock="Left">
                        <PathIcon Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" Width="18" Height="18" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Button Command="{Binding GoToCoreManagerCommand}"
                            DockPanel.Dock="Right"
                            Background="#D97706"
                            Padding="14,8"
                            CornerRadius="10"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z" Width="13" Height="13" Foreground="White" />
                            <TextBlock Text="Скачать ядро" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                        </StackPanel>
                    </Button>

                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="ТРЕБУЕТСЯ ЗАГРУЗКА ЯДРА" FontSize="10" FontWeight="Bold" Foreground="#FBBF24" FontFamily="Consolas, monospace" />
                        <TextBlock Text="{Binding CoreMissingMessage}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 1. HERO LIVE ANIMATED MECHA MASCOT COMMAND ARENA -->
            <Border Classes="glass-card" Padding="28,26" HorizontalAlignment="Stretch">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <!-- Interactive 60 FPS Live Mecha Mascot Control -->
                    <controls:LiveMascotControl Width="220" Height="220"
                                                Command="{Binding ToggleConnectionCommand}"
                                                IsConnected="{Binding IsConnected}"
                                                IsConnecting="{Binding IsConnecting}"
                                                IsTunMode="{Binding IsTunMode}"
                                                IsSystemProxy="{Binding IsSystemProxy}"
                                                HorizontalAlignment="Center" />

                    <!-- Master Action Trigger Capsule -->
                    <Button Classes="hero-connect"
                            Classes.connected="{Binding IsConnected}"
                            Command="{Binding ToggleConnectionCommand}"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="8" Height="8" Fill="#38BDF8" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectButtonText}"
                                        FontWeight="Bold"
                                        FontSize="13"
                                        FontFamily="Consolas, monospace" />
                        </StackPanel>
                    </Button>

                    <!-- Session Duration -->
                    <TextBlock IsVisible="{Binding IsConnected}"
                               Text="{Binding SessionDuration, StringFormat='Время сессии: {0}'}"
                               FontSize="12"
                               Foreground="#94A3B8"
                               FontFamily="Consolas, monospace"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 2. SPEED & TELEMETRY BENTO GRID (2 Columns) -->
            <Grid ColumnDefinitions="*,16,*">
                <!-- Left: Traffic Rates -->
                <Border Grid.Column="0" Classes="glass-card">
                    <StackPanel Spacing="14">
                        <DockPanel>
                            <TextBlock Text="СЕТЕВОЙ ТРАФИК" FontWeight="Bold" FontSize="11" Foreground="#CBD5E1" FontFamily="Consolas, monospace" DockPanel.Dock="Left" />
                            <Border Background="#0C2340" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock Text="● LIVE" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" />
                            </Border>
                        </DockPanel>

                        <!-- Speed Meters Row -->
                        <Grid ColumnDefinitions="*,12,*">
                            <!-- Download Speed Card -->
                            <Border Grid.Column="0" Classes="sub-panel">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="ВХОД" FontSize="9" FontWeight="Bold" Foreground="#64748B" FontFamily="Consolas, monospace" />
                                    <TextBlock Text="{Binding DownloadSpeed}" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" FontFamily="Consolas, monospace" />
                                    <TextBlock Text="{Binding TotalDownload, StringFormat='Всего: {0}'}" FontSize="10" Foreground="#475569" FontFamily="Consolas, monospace" />
                                </StackPanel>
                            </Border>

                            <!-- Upload Speed Card -->
                            <Border Grid.Column="2" Classes="sub-panel">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="ИСХОД" FontSize="9" FontWeight="Bold" Foreground="#64748B" FontFamily="Consolas, monospace" />
                                    <TextBlock Text="{Binding UploadSpeed}" FontSize="16" FontWeight="Bold" Foreground="#C084FC" FontFamily="Consolas, monospace" />
                                    <TextBlock Text="{Binding TotalUpload, StringFormat='Всего: {0}'}" FontSize="10" Foreground="#475569" FontFamily="Consolas, monospace" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right: Node, Mode & Core Engine Switcher -->
                <Border Grid.Column="2" Classes="glass-card">
                    <StackPanel Spacing="12">
                        <DockPanel>
                            <TextBlock Text="УЗЕЛ &amp; РЕЖИМ" FontWeight="Bold" FontSize="11" Foreground="#CBD5E1" FontFamily="Consolas, monospace" DockPanel.Dock="Left" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="● DNS OK" Foreground="#34D399" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" />
                                </Border>
                                <Button Command="{Binding RefreshIpCommand}" Background="Transparent" Padding="4" Cursor="Hand" ToolTip.Tip="Обновить публичный IP">
                                    <PathIcon Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0020 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74A7.93 7.93 0 004 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z" Width="13" Height="13" Foreground="#38BDF8" />
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <!-- Node Ping & IP Box -->
                        <Border Classes="sub-panel">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Left">
                                    <TextBlock Text="ПИНГ:" FontSize="10" Foreground="#64748B" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Consolas, monospace" />
                                    <TextBlock Text="{Binding PingDisplay}" FontSize="13" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" FontFamily="Consolas, monospace" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding PublicIp}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" FontFamily="Consolas, monospace" />
                                    <Border Background="#1E2638" CornerRadius="6" Padding="6,2">
                                        <TextBlock Text="{Binding Country}" FontSize="9" FontWeight="Bold" Foreground="#CBD5E1" FontFamily="Consolas, monospace" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Segmented Mode Control (TUN vs System Proxy) -->
                        <Grid ColumnDefinitions="*,8,*">
                            <Button Grid.Column="0"
                                    Command="{Binding SetModeCommand}"
                                    CommandParameter="tun"
                                    Classes="segment-btn"
                                    Classes.active="{Binding IsTunMode}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="M7 2v11h3v9l7-12h-4l4-8z" Width="12" Height="12" Foreground="#38BDF8" />
                                    <TextBlock Text="TUN (Wintun)" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Command="{Binding SetModeCommand}"
                                    CommandParameter="proxy"
                                    Classes="segment-btn"
                                    Classes.active="{Binding IsSystemProxy}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" Width="12" Height="12" Foreground="#34D399" />
                                    <TextBlock Text="System Proxy" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Segmented Core Selector (Sing-box vs Xray) -->
                        <Grid ColumnDefinitions="*,8,*">
                            <Button Grid.Column="0"
                                    Command="{Binding SetCoreEngineCommand}"
                                    CommandParameter="sing-box"
                                    Classes="segment-btn"
                                    Classes.active="{Binding IsSingboxSelected}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    ToolTip.Tip="Ядро Sing-box (TUN, Reality, PortShield)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" Width="11" Height="11" Foreground="#38BDF8" />
                                    <TextBlock Text="Sing-box" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Command="{Binding SetCoreEngineCommand}"
                                    CommandParameter="xray"
                                    Classes="segment-btn"
                                    Classes.active="{Binding IsXraySelected}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    ToolTip.Tip="Ядро Xray-core (VLESS Reality, VMess, GeoData)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="M13 10V3L4 14h7v7l9-11h-7z" Width="11" Height="11" Foreground="#C084FC" />
                                    <TextBlock Text="Xray-core" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. PROMINENT SERVER CONSOLE CARD -->
            <Border Classes="glass-card" Padding="20,18">
                <DockPanel>
                    <Border Width="46" Height="46" CornerRadius="14"
                            Background="{Binding SelectedServer.BadgeBg, FallbackValue='#1E1B4B'}"
                            BorderBrush="{Binding SelectedServer.BadgeBorder, FallbackValue='#8B5CF6'}"
                            BorderThickness="1"
                            Margin="0,0,16,0"
                            DockPanel.Dock="Left"
                            ToolTip.Tip="{Binding SelectedServer.BadgeToolTip, FallbackValue='Сервер не выбран'}">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock IsVisible="{Binding SelectedServer.IsTextBadge, FallbackValue=False}"
                                       Text="{Binding SelectedServer.BadgeText, FallbackValue=''}"
                                       FontSize="14"
                                       FontWeight="ExtraBold"
                                       Foreground="{Binding SelectedServer.BadgeForeground, FallbackValue='#38BDF8'}"
                                       FontFamily="Consolas, monospace"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <PathIcon IsVisible="{Binding SelectedServer.IsIconBadge, FallbackValue=True}"
                                      Data="{Binding SelectedServer.BadgeIcon, FallbackValue='M7 2v11h3v9l7-12h-4l4-8z'}"
                                      Width="20" Height="20"
                                      Foreground="{Binding SelectedServer.BadgeForeground, FallbackValue='#C084FC'}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Right Change Server Button -->
                    <Button Classes="segment-btn"
                            Command="{Binding GoToServersCommand}"
                            DockPanel.Dock="Right"
                            Padding="14,8"
                            CornerRadius="10"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <TextBlock Text="Сменить узел →" FontSize="11" FontWeight="Bold" Foreground="#C084FC" />
                    </Button>

                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="АКТИВНЫЙ СЕРВЕР" FontSize="10" FontWeight="Bold" Foreground="#64748B" FontFamily="Consolas, monospace" />
                            <Border Background="#3B0764" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="8" Padding="6,1">
                                <TextBlock Text="{Binding SelectedServer.Protocol, FallbackValue='VLESS REALITY'}" FontSize="9" FontWeight="Bold" Foreground="#D8B4FE" FontFamily="Consolas, monospace" />
                            </Border>
                            <Button Command="{Binding GoToCoreManagerCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip.Tip="Нажмите для выбора / настройки ядер">
                                <Border Background="{Binding SelectedCoreEngine.BgColor}" BorderBrush="{Binding SelectedCoreEngine.Color}" BorderThickness="1" CornerRadius="8" Padding="6,1">
                                    <TextBlock Text="{Binding SelectedCoreEngine.DisplayName, StringFormat='Ядро: {0}'}" FontSize="9" FontWeight="Bold" Foreground="{Binding SelectedCoreEngine.Color}" FontFamily="Consolas, monospace" />
                                </Border>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedServer.Name, FallbackValue='Сервер не выбран'}" FontSize="15" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="{Binding SelectedServer.Subtitle, FallbackValue='Нажмите для выбора сервера'}" FontSize="11" Foreground="#64748B" FontFamily="Consolas, monospace" />
                    </StackPanel>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

    <!-- MODAL ALERT POPUP NOTIFICATION -->
    <Border IsVisible="{Binding HasAlert}"
            Background="#99060A14"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Border Background="#121829"
                BorderBrush="#F59E0B"
                BorderThickness="1.5"
                CornerRadius="18"
                Padding="28,24"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 16 48 0 #80000000">
            <StackPanel Spacing="16">
                <DockPanel>
                    <!-- Warning Icon -->
                    <Border Width="48" Height="48" CornerRadius="12" Background="#3B1E08" BorderBrush="#F59E0B" BorderThickness="1" Margin="0,0,16,0" DockPanel.Dock="Left">
                        <PathIcon Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" Width="22" Height="22" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AlertTitle}" FontSize="13.5" FontWeight="ExtraBold" Foreground="#FBBF24" FontFamily="Consolas, monospace" />
                        <TextBlock Text="{Binding AlertMessage}" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="18" />
                    </StackPanel>
                </DockPanel>

                <!-- Action Buttons Row -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
                    <Button Command="{Binding DismissAlertCommand}"
                            Background="#1E2638"
                            Foreground="#94A3B8"
                            Padding="16,8"
                            CornerRadius="10"
                            Cursor="Hand">
                        <TextBlock Text="Закрыть" FontSize="11.5" FontWeight="SemiBold" />
                    </Button>

                    <Button Command="{Binding ExecuteAlertActionCommand}"
                            Background="#D97706"
                            Foreground="White"
                            Padding="18,8"
                            CornerRadius="10"
                            Cursor="Hand">
                        <TextBlock Text="{Binding AlertActionText}" FontSize="11.5" FontWeight="Bold" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Grid>
</UserControl>
