<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SentinelDesktop.ViewModels"
             xmlns:models="using:SentinelDesktop.Models"
             x:Class="SentinelDesktop.Views.Servers.ServersView"
             x:DataType="vm:ServersViewModel"
             x:Name="Root">

    <Grid RowDefinitions="Auto,Auto,*" Margin="32,24,32,28">
        
        <!-- 1. TOOLBAR HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
            <!-- Left Info -->
            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Подключения и серверы" FontSize="22" FontWeight="ExtraBold" Foreground="White" />
                    <Border Background="#1E1B4B" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalServersCount, StringFormat='Узлов: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#D8B4FE" FontFamily="Consolas, monospace" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Нативная конфигурация защищенных туннелей VLESS Reality, Trojan, Hysteria 2" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Right Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- Ping All -->
                <Button Command="{Binding PingAllCommand}"
                        Padding="14,9" CornerRadius="12" Background="#141A30" BorderBrush="#253050" BorderThickness="1" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M2 22h20V2z" Width="13" Height="13" Foreground="#38BDF8" />
                        <TextBlock Text="Тест пинга всех" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" />
                    </StackPanel>
                </Button>

                <!-- Import Button -->
                <Button Command="{Binding OpenImportDialogCommand}"
                        Classes="accent-glow" Padding="16,9" CornerRadius="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="12" Height="12" Foreground="White" />
                        <TextBlock Text="Импорт ссылки" FontSize="12" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. STATUS NOTIFICATION BANNER -->
        <Border Grid.Row="1" IsVisible="{Binding HasStatusMessage}"
                Background="#0F1F38" BorderBrush="#0284C7" BorderThickness="1"
                CornerRadius="12" Padding="14,10" Margin="0,0,0,16">
            <DockPanel>
                <PathIcon Data="M7 2v11h3v9l7-12h-4l4-8z" Width="14" Height="14" Foreground="#38BDF8" Margin="0,0,10,0" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" FontFamily="Consolas, monospace" />
            </DockPanel>
        </Border>

        <!-- 3. IMPORT DIALOG PANEL -->
        <Border Grid.Row="1" IsVisible="{Binding IsImportOpen}"
                Classes="glass-card" Padding="20" Margin="0,0,0,18"
                BorderBrush="#8B5CF6">
            <StackPanel Spacing="12">
                <DockPanel>
                    <TextBlock Text="Импорт конфигурации узлов через ядро Sentinel" FontSize="14" FontWeight="Bold" Foreground="White" DockPanel.Dock="Left" />
                    <Button Command="{Binding CloseImportDialogCommand}" Background="Transparent" Padding="4" HorizontalAlignment="Right" Cursor="Hand">
                        <TextBlock Text="✕" FontSize="13" Foreground="#94A3B8" />
                    </Button>
                </DockPanel>

                <TextBox Text="{Binding ImportUriText, Mode=TwoWay}"
                         AcceptsReturn="True"
                         Watermark="Вставьте ссылки формата vless://, vmess://, trojan://, ss://, hysteria2:// (по одной на строку)"
                         Height="75"
                         FontFamily="Consolas, monospace"
                         FontSize="11"
                         CornerRadius="10"
                         Background="#080C1A"
                         BorderBrush="#1E293B" />

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Command="{Binding PasteFromClipboardCommand}"
                            Padding="12,7" CornerRadius="10" Background="#1E2638" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Width="12" Height="12" Foreground="#CBD5E1" />
                            <TextBlock Text="Вставить из буфера" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CloseImportDialogCommand}"
                            Padding="14,7" CornerRadius="10" Background="Transparent" Foreground="#94A3B8" Cursor="Hand">
                        <TextBlock Text="Отмена" FontSize="11" FontWeight="SemiBold" />
                    </Button>

                    <Button Command="{Binding ImportUriCommand}"
                            Classes="accent-glow" Padding="16,7" CornerRadius="10">
                        <TextBlock Text="Импортировать" FontSize="11" FontWeight="Bold" Foreground="White" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 4. SERVERS LIST VIEW -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Servers}" x:CompileBindings="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="glass-card"
                                Margin="0,0,0,12"
                                Padding="18,14"
                                BorderBrush="{Binding CardBorder}">
                            <DockPanel>
                                <!-- Left: Radio Selector & Country Code Badge -->
                                <StackPanel Orientation="Horizontal" Spacing="12" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <!-- Active Selection Dot -->
                                    <Button Command="{Binding #Root.DataContext.SelectServerCommand}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip.Tip="Выбрать активный сервер">
                                        <Border Width="24" Height="24" CornerRadius="12"
                                                Background="#0D1122"
                                                BorderBrush="{Binding SelectionDotBorder}"
                                                BorderThickness="2">
                                            <Ellipse Width="10" Height="10"
                                                     Fill="{Binding SelectionDotFill}" />
                                        </Border>
                                    </Button>

                                    <!-- Country Code Badge -->
                                    <Border Width="38" Height="38" CornerRadius="12" Background="#141A30" BorderBrush="#253050" BorderThickness="1">
                                        <TextBlock Text="{Binding CountryCode}" FontSize="12" FontWeight="ExtraBold" Foreground="#38BDF8" FontFamily="Consolas, monospace" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>

                                <!-- Right: Ping Pill & Action Buttons -->
                                <StackPanel Orientation="Horizontal" Spacing="10" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <!-- Ping Pill (Clickable directly) -->
                                    <Button Command="{Binding #Root.DataContext.PingSingleCommand}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip.Tip="Нажмите для замера пинга">
                                        <Border Background="{Binding PingBg}"
                                                BorderBrush="{Binding PingColor}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10,5">
                                            <TextBlock Text="{Binding PingDisplay}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding PingColor}" FontFamily="Consolas, monospace" />
                                        </Border>
                                    </Button>

                                    <!-- Single Ping Action (Refresh Button) -->
                                    <Button Command="{Binding #Root.DataContext.PingSingleCommand}"
                                            CommandParameter="{Binding}"
                                            Background="#141A30" BorderBrush="#253050" BorderThickness="1"
                                            Padding="9,8" CornerRadius="8" Cursor="Hand" ToolTip.Tip="Проверить пинг">
                                        <PathIcon Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0020 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74A7.93 7.93 0 004 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z" Width="14" Height="14" Foreground="#38BDF8" />
                                    </Button>

                                    <!-- Delete Button (Trash) -->
                                    <Button Command="{Binding #Root.DataContext.DeleteServerCommand}"
                                            CommandParameter="{Binding}"
                                            Background="#2D1215" BorderBrush="#7F1D1D" BorderThickness="1"
                                            Padding="9,8" CornerRadius="8" Cursor="Hand" ToolTip.Tip="Удалить узел">
                                        <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="14" Height="14" Foreground="#F87171" />
                                    </Button>
                                </StackPanel>

                                <!-- Center: Node Info & Metadata -->
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- Protocol Badge -->
                                        <Border Background="#1E1B4B" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="6" Padding="6,1">
                                            <TextBlock Text="{Binding ProtocolDisplay}" FontSize="9" FontWeight="Bold" Foreground="#D8B4FE" FontFamily="Consolas, monospace" />
                                        </Border>

                                        <!-- Server Name -->
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="White" />
                                    </StackPanel>

                                    <!-- Subtitle / Host / SNI -->
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#64748B" FontFamily="Consolas, monospace" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
